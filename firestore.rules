rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-by-default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Validation for incoming inquiries from contact form
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'service', 'message', 'createdAt', 'status'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 3000
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('service' in data) || (data.service is string && data.service.size() <= 100))
        && (!('status' in data) || (data.status is string && data.status in ['new', 'contacted', 'archived']))
        && data.createdAt is string;
    }

    // Inquiries Collection: Public create, admin read/update/delete
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read, update, delete: if isSignedIn();
    }

    // Addons Collection: Public read, admin write
    match /addons/{addonId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(addonId);
    }

    // Site Settings Collection: Public read, admin write
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(settingId);
    }
  }
}
